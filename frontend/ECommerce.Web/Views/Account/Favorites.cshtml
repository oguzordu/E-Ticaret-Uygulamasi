@model List<ECommerce.Web.Models.Favorite>
@{
    ViewData["Title"] = "Favorilerim";
}

<div class="container animate-up mt-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
            <i class="bi bi-heart-fill fs-4"></i>
        </div>
        <div>
            <h1 class="h3 fw-bold mb-0">Favorilerim</h1>
            <p class="text-muted small mb-0">Beğendiğiniz ürünler burada listelenir</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var fav in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm product-card">
                        <div class="position-relative">
                             @{
                                string exactPath = $"/images/products/{fav.Product.Name}.png";
                                string fallbackUrl = "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&q=80&w=150";
                                var pName = fav.Product.Name?.ToLower() ?? "";
                                var cName = fav.Product.CategoryName?.ToLower() ?? ""; // Fixed: Use CategoryName directly
                                if (cName.Contains("telefon") || pName.Contains("telefon")) fallbackUrl = "/images/products/telefon.png";
                                else if (cName.Contains("laptop") || pName.Contains("laptop")) fallbackUrl = "/images/products/laptop.png";
                                else if (cName.Contains("kulaklık")) fallbackUrl = "/images/products/kulaklık.png";
                                else if (cName.Contains("ayakkabı")) fallbackUrl = "/images/products/ayakkabi.png";
                            }
                            <img src="@exactPath" class="card-img-top p-4" alt="@fav.Product.Name" style="height: 250px; object-fit: contain;" onerror="this.onerror=null;this.src='@fallbackUrl';">
                            
                            <form asp-action="ToggleFavorite" asp-controller="Home" method="post" class="position-absolute top-0 end-0 m-3">
                                <input type="hidden" name="productId" value="@fav.ProductId" />
                                <button type="submit" class="btn btn-light rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center text-danger" style="width: 35px; height: 35px;">
                                    <i class="bi bi-heart-fill"></i>
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark text-truncate">@fav.Product.Name</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fs-5 fw-bold text-primary">@fav.Product.Price.ToString("N2") ₺</span>
                                <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@fav.ProductId" class="btn btn-outline-primary btn-sm rounded-pill">
                                    İncele
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-heart-break fs-1 text-muted opacity-25"></i>
            </div>
            <h4 class="fw-normal text-muted">Henüz favori ürününüz yok.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-3 px-4">
                Alışverişe Başla
            </a>
        </div>
    }
</div>
