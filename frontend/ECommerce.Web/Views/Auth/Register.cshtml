@model ECommerce.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container animate-up mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-premium overflow-hidden border-0 shadow-xl">
                <div class="row g-0">
                     <!-- Right Side - Image (flipped for register) -->
                    <div class="col-lg-6 d-none d-lg-block">
                        <div style="height: 100%; background: url('https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80') center/cover no-repeat; position: relative;">
                            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(15, 23, 42, 0.8), transparent);"></div>
                            <div class="position-absolute bottom-0 start-0 p-5 text-white">
                                <h3 class="fw-bold text-white mb-2">Aramıza Katılın</h3>
                                <p class="opacity-75">Sınırsız alışveriş dünyasının kapılarını aralayın.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Left Side - Form -->
                    <div class="col-lg-6 p-5 bg-white d-flex flex-column justify-content-center">
                        <div class="mb-5">
                             <h2 class="fw-bold mb-2">Hesap Oluştur</h2>
                             <p class="text-secondary">Hızlıca üye olun, avantajları yakalayın.</p>
                        </div>
                        
                        <form asp-action="Register" method="post">
                            <div class="mb-4">
                                <label class="small fw-bold text-muted mb-2">E-POSTA</label>
                                <input asp-for="Email" class="form-control form-control-lg bg-light border-0 shadow-focus" placeholder="ornek@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-4">
                                <label class="small fw-bold text-muted mb-2">ŞİFRE</label>
                                <input asp-for="Password" type="password" class="form-control form-control-lg bg-light border-0 shadow-focus" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">Ücretsiz Kayıt Ol</button>
                            
                            <div class="text-center">
                                <p class="text-muted">Zaten üye misiniz? <a asp-action="Login" class="text-primary fw-bold">Giriş Yap</a></p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
