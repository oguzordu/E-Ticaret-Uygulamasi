@model List<ECommerce.Web.Models.Category>
@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="container" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0">Kategori Yönetimi</h1>
            <p class="text-muted small mb-0">Ürün kategorilerini listeleyin</p>
        </div>
        <a asp-action="AddCategory" class="btn btn-primary rounded-pill shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-2"></i>Yeni Kategori Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm">
         <div class="card-header bg-white py-3 border-0">
            <div class="alert alert-info border-0 bg-info-subtle text-info-emphasis d-flex align-items-center mb-0">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>
                    <strong>Bilgi:</strong> Kategori işlemleri API üzerinden yönetilmektedir.
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                @foreach (var category in Model)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                        <span class="fw-medium">
                            <i class="bi bi-folder2-open me-2 text-warning"></i> @category.Name
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-muted border rounded-pill me-2">ID: @category.Id</span>
                            
                            <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary rounded-circle shadow-sm" title="Düzenle">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            
                            <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle shadow-sm" title="Sil">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

