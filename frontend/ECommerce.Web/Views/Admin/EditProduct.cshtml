@model ECommerce.Web.Models.Product
@{
    ViewData["Title"] = "Ürün Düzenle";
    Layout = "_Layout";
}

<div class="container mt-5 animate-up">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <h4 class="card-title fw-bold">Ürünü Düzenle: @Model.Name</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="EditProduct" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-secondary fw-bold small">ÜRÜN ADI</label>
                                <input asp-for="Name" class="form-control bg-light border-0 fw-medium" required />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label text-secondary fw-bold small">KATEGORİ</label>
                                <select asp-for="CategoryId" class="form-select bg-light border-0 fw-medium" required>
                                    @foreach (var cat in ViewBag.Categories as List<ECommerce.Web.Models.Category>)
                                    {
                                        <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-secondary fw-bold small">FİYAT (₺)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-light border-0 fw-medium" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-secondary fw-bold small">STOK ADEDİ</label>
                                <input asp-for="Stock" type="number" class="form-control bg-light border-0 fw-medium" required />
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">GÜNCELLE</button>
                            <a asp-action="Products" class="btn btn-light fw-bold text-muted">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
