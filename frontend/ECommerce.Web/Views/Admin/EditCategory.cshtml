@model ECommerce.Web.Models.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="container animate-up" style="max-width: 600px;">
    <div class="mb-4">
        <a asp-action="Categories" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left me-2"></i>Kategorilere Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white border-0 py-4 px-4">
            <h1 class="h4 fw-bold mb-0">Kategori Düzenle</h1>
            <p class="text-muted small mb-0">Seçili kategorinin adını güncelleyin.</p>
        </div>
        <div class="card-body p-4 pt-0">
            <form asp-action="EditCategory" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-4">
                    <label class="form-label fw-bold small text-secondary">KATEGORİ ADI</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-tag"></i>
                        </span>
                        <input asp-for="Name" class="form-control bg-light border-start-0 ps-0 py-3 fw-bold" placeholder="Örn: Elektronik" required />
                    </div>
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                        DÜZENLEMEYİ KAYDET
                    </button>
                    <a asp-action="Categories" class="btn btn-light btn-lg border fw-bold text-secondary">
                        İPTAL
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
