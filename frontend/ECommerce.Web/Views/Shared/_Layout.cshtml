<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StorePro</title>
    
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    
    <!-- Floating Navbar -->
    <nav class="navbar navbar-expand-lg navbar-floating">
        <div class="container container-lg">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-bag-fill"></i>
                </div>
                <span class="fs-4">Store<span class="text-secondary fw-light">Pro</span></span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="bi bi-list fs-2"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#products">Ürünler</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <!-- Cart -->
                    @if (Context.Session.GetString("Token") != null)
                    {
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-light rounded-circle p-0 position-relative d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-cart2 fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="width: 12px; height: 12px;"></span>
                        </a>
                    }
                    else
                    {
                         <a asp-controller="Auth" asp-action="Login" class="btn btn-light rounded-circle p-0 position-relative d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-cart2 fs-5"></i>
                        </a>
                    }

                    @if (Context.Session.GetString("Token") != null)
                    {
                        <div class="dropdown">
                            <button class="btn btn-primary d-flex align-items-center gap-2 ps-2 pe-3 py-2 ms-2 rounded-pill" data-bs-toggle="dropdown">
                                <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                    <span class="small fw-bold">@Context.Session.GetString("UserEmail")?.Substring(0, 1).ToUpper()</span>
                                </div>
                                <span class="small">Hesabım</span>
                                <i class="bi bi-chevron-down small opacity-75"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-xl border-0 rounded-4 mt-2 p-2">
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Orders" asp-action="Index">Siparişlerim</a></li>
                                @if (Context.Session.GetString("IsAdmin") == "True")
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header text-muted small">YÖNETİCİ PANELİ</h6></li>
                                    <li><a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Products">
                                        <i class="bi bi-box-seam text-primary"></i>
                                        <div>
                                            <div class="fw-medium">Ürünler</div>
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">Stok Kontrolü</small>
                                        </div>
                                    </a></li>
                                    <li><a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Orders">
                                        <i class="bi bi-receipt text-success"></i>
                                        <div>
                                            <div class="fw-medium">Verilen Siparişler</div>
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">Sipariş Yönetimi</small>
                                        </div>
                                    </a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item rounded-2 py-2 text-danger" asp-controller="Auth" asp-action="Logout">Çıkış Yap</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary ms-2 px-4 rounded-pill">Giriş Yap</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div style="min-height: 80vh;">
        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container mt-4 mb-0">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success border-0 shadow-sm d-flex align-items-center gap-3 rounded-4 p-3 animate-up">
                                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                                <div>@TempData["Success"]</div>
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center gap-3 rounded-4 p-3 animate-up">
                                <i class="bi bi-exclamation-circle-fill fs-4 text-danger"></i>
                                <div>@TempData["Error"]</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        
        @RenderBody()
    </div>

    <!-- Modern Footer -->
    <footer class="bg-white pt-5 pb-4 border-top mt-5">
        <div class="container">
            <div class="row g-5 justify-content-between mb-5">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-bag-fill small"></i>
                        </div>
                        <span class="fw-bold fs-5">StorePro</span>
                    </div>
                    <p class="text-secondary">Premium alışveriş deneyimi. En yeni teknoloji ve modalara anında ulaşın.</p>
                </div>
                
                <div class="col-lg-3">
                     <h6 class="fw-bold mb-3">Hızlı Bağlantılar</h6>
                     <ul class="list-unstyled text-secondary">
                         <li><a asp-controller="Home" asp-action="Index" class="text-reset">Ana Sayfa</a></li>
                         <li><a href="#products" class="text-reset">Ürünler</a></li>
                     </ul>
                </div>
            </div>
            <div class="row pt-4 border-top border-light">
                <div class="col-md-6 text-center text-md-start">
                    <p class="small text-muted mb-0">&copy; 2025 StorePro Inc.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
